    "exits": {
      "lighthouse": 9,
      "tunnel": 5
    }
  },
  {
    "id": 11,
    "name": "Spiral Staircase",
    "description": "The steps groan beneath you. Footprints of wet sand lead up ahead of you.",
    "exits": {
      "lighthouse": 9,
      "watchroom": 12
    }
  },
  {
    "id": 12,
    "name": "Watch Room",
    "description": "Charts of the coast cover the walls, each marking a ship that never arrived.",
    "exits": {
      "staircase": 11,
      "lantern": 13
    }
  },
  {
    "id": 13,
    "name": "Lantern Room",
    "description": "The great lens is cracked. Something beneath the sea seems to wait for the light.",
    "exits": {
      "watchroom": 12,
      "gallery": 14
    }
  },
  {
    "id": 14,
    "name": "Gallery Walkway",
